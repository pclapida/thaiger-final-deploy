# Secretos de las Edge Functions. Copia este archivo como supabase/.env.functions
# (está en .gitignore), rellénalo y súbelo con:
#
#   npx supabase secrets set --env-file supabase/.env.functions
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY NO van aquí: la
# plataforma los inyecta sola en cada función.

# Dominio público de la tienda, sin barra final. Se usa para las URLs de
# regreso de Mercado Pago, los enlaces de los correos y el CORS.
SITE_URL=https://www.tu-dominio.mx

# --- Mercado Pago (Tus integraciones → tu aplicación → Credenciales) ---------
# Usa las de PRUEBA hasta el ensayo final; las de producción sólo al abrir.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Tus integraciones → tu aplicación → Webhooks → "Clave secreta".
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Correos (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente. El dominio tiene que estar verificado en Resend.
MAIL_FROM=Thaiger Supplements <pedidos@tu-dominio.mx>
# A quién avisar de cada pedido nuevo (opcional).
NOTIFY_ADMIN_EMAIL=ventas@tu-dominio.mx
# El mismo valor que le pases a configurar_notificaciones() en SQL. Inventa uno
# largo:  openssl rand -hex 32
NOTIFY_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# --- Skydropx (sólo si en Ajustes → Envíos eliges Skydropx) -------------------
# SKYDROPX_CLIENT_ID=
# SKYDROPX_CLIENT_SECRET=
# Para probar sin comprar guías de verdad:
# SKYDROPX_BASE_URL=https://sb-pro.skydropx.com
